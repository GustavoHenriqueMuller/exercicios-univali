[
  {
    "name": "type",
    "regex":  "\\b(int|float|double|string|char|boolean|void)\\b"
  },
  {
    "name": "structure",
    "regex":  "\\b(if|else|elseif|while|do|for|default|when|is|and|or|not)\\b"
  },
  {
    "name": "modifier",
    "regex":  "\\b(const|ref|return)\\b"
  },
  {
    "name": "boolLiteral",
    "regex":  "\\b(true|false)\\b"
  },
  {
    "name": "stringLiteral",
    "regex":  "\"([^\\\"]|(\\\\\\\"))*\""
  },
  {
    "name": "charLiteral",
    "regex": "'([^']|(\\'))?'"
  },
  {
    "name": "lineComment",
    "regex":  "\/\/.*"
  },
  {
    "name": "decimalLiteral",
    "regex":  "\\b[0-9]+\\b"
  },
  {
    "name": "hexadecimalLiteral",
    "regex":  "\\b0[xX][0-9a-fA-F]+\\b"
  },
  {
    "name": "binaryLiteral",
    "regex":  "\\b0[bB][01]+\\b"
  },
  {
    "name": "floatLiteral",
    "regex":  "\\b[0-9]+(\\.[0-9]+)?f?\\b"
  },
  {
    "name": "id",
    "regex":  "[a-z_$][\\w$]*"
  }
]
