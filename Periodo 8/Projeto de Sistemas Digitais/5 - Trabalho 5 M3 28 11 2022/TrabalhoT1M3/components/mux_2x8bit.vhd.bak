library IEEE;
use IEEE.std_logic_1164.all;

entity mux_2x8bit is
	port
	(
		i_A: in std_logic_vector (7 downto 0);
		i_B: in std_logic_vector (7 downto 0);
		i_SEL: in std_logic;
		o_R: out std_logic_vector (7 downto 0);
	);
end mux_2x8bit;

architecture arch_mux_2x8bit of mux_2x8bit is
begin
	process (i_A, i_B, i_SEL)
	begin
		if (i_SEL = '0') then
			o_R <= i_A;
		elsif (i_SEL = '1') then
			o_R <= i_B;
		end;
	end process;
end arch_mux_2x8bit;