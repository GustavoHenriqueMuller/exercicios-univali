library IEEE;
use IEEE.std_logic_1164.all;

entity adder_4bit_tb is
end adder_4bit_tb;

architecture arch_adder_4bit_tb of adder_4bit_tb is

component adder_4bit is
	port
	(
		i_A: in std_logic_vector (3 downto 0);
		i_B: in std_logic_vector (3 downto 0);
		o_R: out std_logic_vector (3 downto 0);
		o_CARRY_OUT: out std_logic
	);
end component;

signal w_A: std_logic (3 downto 0);
signal w_B: std_logic (3 downto 0);
signal w_R: std_logic (3 downto 0);
signal w_CARRY_OUT: std_logic;

begin
	u_ADDER: adder_4bit port map (w_A, w_B, w_R, w_CARRY_OUT);

	process
	begin
		-- Test 1
		w_A <= "1001";
		w_B <= "0011";
		w_CARRY_IN <= '0';
		
		wait for 1ns;
		assert (w_R = "1100") report "Fail adder_4bit -> Test 1" severity error;
		assert (w_CARRY_OUT = '0') report "Fail adder_4bit -> Test 1" severity error;
		
		-- Test 2
		w_A <= "1111";
		w_B <= "0001";
		w_CARRY_IN <= '0';
		
		wait for 1ns;
		assert (w_R = "0000") report "Fail adder_4bit -> Test 2" severity error;
		assert (w_CARRY_OUT = '1') report "Fail adder_4bit -> Test 2" severity error;
		
		-- Test 3
		w_A <= "0101";
		w_B <= "0010";
		w_CARRY_IN <= '1';
		
		wait for 1ns;
		assert (w_R = "1000") report "Fail adder_4bit -> Test 3" severity error;
		assert (w_CARRY_OUT = '0') report "Fail adder_4bit -> Test 3" severity error;
	
		wait;
	end process;
end arch_adder_4bit_tb;