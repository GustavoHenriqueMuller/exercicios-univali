library IEEE;
use IEEE.std_logic_1164.all;

entity and_4bit_tb is
end and_4bit_tb;

architecture arch_and_4bit_tb of and_4bit_tb is

component and_4bit is
	port
	(
		i_A: in std_logic_vector (3 downto 0);
		i_B: in std_logic_vector (3 downto 0);
		o_R: out std_logic_vector (3 downto 0)
	);
end component;

signal w_A: in std_logic_vector (3 downto 0);
signal w_B: in std_logic_vector (3 downto 0);
signal w_R: out std_logic_vector (3 downto 0)

begin
	u_AND: and_4bit port map (w_A, w_B, w_R);

	process
	begin
		w_A <= "1111";
		w_B <= "0000";
		
		
		
		
		w_A <= "0101";
		w_B <= "1100";
	
		wait;
	end process;
end and_4bit_tb;