library IEEE;
use IEEE.std_logic_1164.all;

entity ula_4bit_tb is
end ula_4bit_tb;

architecture arch_ula_4bit_tb of ula_4bit_tb is

component ula_4bit is
	port
	(
		i_A: in std_logic_vector (3 downto 0);
		i_LOAD: in std_logic;
		i_CLK: in std_logic;
		o_R: out std_logic_vector (3 downto 0)
	);
end component;

signal w_A: std_logic (3 downto 0);
signal w_LOAD: std_logic;
signal w_CLK: std_logic;
signal w_R: std_logic (3 downto 0);

begin
	u_REGISTER: ula_4bit port map (w_A, w_B, w_R, w_CARRY_OUT);

	process
	begin
		-- Test 1
		w_A <= "1001";
		w_LOAD <= "1";
		
		-- Clock pulse
		w_CLK <= "0";
		wait for 1ns;
		w_CLK <= "1";
		wait for 1ns;
		w_CLK <= "0";
		
		wait for 1ns;
		assert (w_R = "1001") report "Fail ula_4bit -> Test 1" severity error;
	
		wait;
	end process;
end arch_ula_4bit_tb;