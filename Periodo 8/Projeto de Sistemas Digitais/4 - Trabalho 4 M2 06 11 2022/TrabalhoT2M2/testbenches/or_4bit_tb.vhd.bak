library IEEE;
use IEEE.std_logic_1164.all;

entity or_4bit_tb is
end or_4bit_tb;

architecture arch_or_4bit_tb of or_4bit_tb is

component or_4bit is
	port
	(
		i_A: in std_logic_vector (3 downto 0);
		i_B: in std_logic_vector (3 downto 0);
		o_R: out std_logic_vector (3 downto 0)
	);
end component;

signal w_A: in std_logic_vector (3 downto 0);
signal w_B: in std_logic_vector (3 downto 0);
signal w_R: out std_logic_vector (3 downto 0)

begin
	u_OR: or_4bit port map (w_A, w_B, w_R);

	process
	begin
		-- Test 1
		w_A <= "1001";
		w_B <= "1001";
		
		wait for 1ns;
		assert (w_R = "1001") report "Fail OR_4bit -> Test 1" severity error;
		
		-- Test 2
		w_A <= "0101";
		w_B <= "1100";
		
		wait for 1ns;
		assert (w_R = "1101") report "Fail OR_4bit -> Test 2" severity error;
				
		-- Test 3
		w_A <= "1010";
		w_B <= "0101";
		
		wait for 1ns;
		assert (w_R = "1111") report "Fail OR_4bit -> Test 3" severity error;
	
		wait;
	end process;
end or_4bit_tb;