		$display ("     Real value = %b", shamt_prev);
		nummismatches = nummismatches + 1;
		on_first_change[19] = 1'b0;
		last_shamt_exp[4] = shamt_expected_prev[4];
	end

	trigger <= ~trigger;
end
initial 

begin 
$timeformat(-12,3," ps",6);
#1000000;
if (nummismatches > 0)
	$display ("%d mismatched vectors : Simulation failed !",nummismatches);
else
	$display ("Simulation passed !");
$finish;
end 
endmodule

module mips_mono_vlg_vec_tst();
// constants                                           
// general purpose registers
reg clock;
reg reset;
// wires                                               
wire [1:0] ALUOp;
wire ALUSrc;
wire Branch;
wire clkSys;
wire [5:0] function;
wire [15:0] imed16;
wire [31:0] Instruction;
wire MemToReg;
wire MemWrite;
wire [31:0] nextPC;
wire [31:26] op;
wire [2:0] Operation;
wire [31:0] PC;
wire [15:11] rd;
wire RegDst;
wire RegWrite;
wire [25:21] rs;
wire [20:16] rt;
wire [10:6] shamt;

wire sampler;                             

// assign statements (if any)                          
mips_mono i1 (
// port map - connection between master ports and signals/registers   
	.ALUOp(ALUOp),
	.ALUSrc(ALUSrc),
	.Branch(Branch),
	.clkSys(clkSys),
	.clock(clock),
	.\function (function),
	.imed16(imed16),
	.Instruction(Instruction),
	.MemToReg(MemToReg),
	.MemWrite(MemWrite),
	.nextPC(nextPC),
	.op(op),
	.Operation(Operation),
	.PC(PC),
	.rd(rd),
	.RegDst(RegDst),
	.RegWrite(RegWrite),
	.reset(reset),
	.rs(rs),
	.rt(rt),
	.shamt(shamt)
);

// reset
initial
begin
	reset = 1'b0;
	reset = #10000 1'b1;
end 

// clock
initial
begin
	clock = 1'b1;
	# 1000;
	repeat(49)
	begin
		clock = 1'b0;
		clock = #10000 1'b1;
		# 10000;
	end
	clock = 1'b0;
	clock = #10000 1'b1;
end 

mips_mono_vlg_sample_tst tb_sample (
	.clock(clock),
	.reset(reset),
	.sampler_tx(sampler)
);

mips_mono_vlg_check_tst tb_out(
	.ALUOp(ALUOp),
	.ALUSrc(ALUSrc),
	.Branch(Branch),
	.clkSys(clkSys),
	.function(function),
	.imed16(imed16),
	.Instruction(Instruction),
	.MemToReg(MemToReg),
	.MemWrite(MemWrite),
	.nextPC(nextPC),
	.op(op),
	.Operation(Operation),
	.PC(PC),
	.rd(rd),
	.RegDst(RegDst),
	.RegWrite(RegWrite),
	.rs(rs),
	.rt(rt),
	.shamt(shamt),
	.sampler_rx(sampler)
);
endmodule

